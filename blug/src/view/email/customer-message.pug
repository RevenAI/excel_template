extends ./base-layout.pug

block content
  table(width="100%" cellspacing="0" cellpadding="0" style="max-width: 600px; margin: auto;")

    tr
      td.content-wrapper(style="padding: 30px 20px; background: #fafafa;")

        // Subject (Centered & Responsive)
        h2.subject-title(style="margin: 0 0 25px; text-align: center; color: #1e3a8a; font-weight: bold;")
          = subject || ''

        // Greeting
        p.text-base(style="margin: 0 0 15px; text-align: left;")
          | Dear #{customerName},

        // Message
        p.text-base(style="margin: 0 0 20px; text-align: left;")
          = message

        // Signature
        p(style="margin: 30px 0 5px; text-align: left; font-size: 14px; line-height: 1.4;")
          | Best regards,

        p(style="margin: 0; font-weight: bold; text-align: left; font-size: 14px; line-height: 1.4;")
          | Customer Services

        p(style="margin: 2px 0 0; text-align: left; font-size: 12px; line-height: 1.4; color: #555;")
          = companyNameFull

  // Responsive Typography
  style.
    .subject-title {
      font-size: 22px;
      line-height: 1.3;
    }

    .text-base {
      font-size: 16px;
      line-height: 1.7;
      color: #333;
    }

    .text-small {
      font-size: 14px;
      line-height: 1.6;
    }

    /* Mobile Scaling */
    @media only screen and (max-width: 600px) {

      .subject-title {
        font-size: 18px !important;
      }

      .text-base {
        font-size: 15px !important;
      }

      .text-small {
        font-size: 13px !important;
      }
    }
